FROM rust:1.82 AS build
WORKDIR /src
COPY . .
RUN cargo build --release

FROM gcr.io/distroless/cc-debian12
COPY --from=build /src/target/release/svc-rust /svc-rust
EXPOSE 8080
ENTRYPOINT ["/svc-rust"]
