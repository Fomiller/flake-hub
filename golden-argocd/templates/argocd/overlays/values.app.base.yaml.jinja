{% if argocd.enabled %}
# Written once, then it is yours. `nix run .#generate` never touches it again.
#
# Shared chart values. Every Application reads this file first and layers the
# environment's own values.app.yaml on top, so a per-environment file only
# carries what actually differs.

fullnameOverride: {{ name }}

replicas: 1

# No image here on purpose. The chart's own values run a hello-world, so a
# freshly bootstrapped repo deploys before it has ever built anything. Point
# this at the repo's ECR image once there is one:
#
#   image:
#     repository: 695434033664.dkr.ecr.us-east-1.amazonaws.com/{{ name }}

# That registry is private, so the kubelet needs a credential to pull from it.
# external-secrets mints this Secret into every namespace labelled for it; the
# name has to match what that ClusterExternalSecret creates.
imagePullSecrets:
  - name: ecr-image-pull
{% endif %}
