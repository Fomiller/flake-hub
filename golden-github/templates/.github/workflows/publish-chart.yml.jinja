{% if github.publishChart %}
{% include "_github_header.jinja" %}

name: Publish chart

on:
  pull_request:
    paths: [helm/**, .github/workflows/publish-chart.yml]
  push:
    branches: [main]
    paths: [helm/**, .github/workflows/publish-chart.yml]
  # Cuts a release candidate off whatever branch it runs from, so a chart can
  # be published and deployed before it merges. Run from main and it cuts the
  # stable release a merge would have cut.
  workflow_dispatch:

jobs:
{% if github.publishImage %}
  # Kargo pairs the newest chart with the newest image. A chart that lands
  # before its commit's image ships with the previous image, so wait for it.
  wait-for-image:
    if: github.event_name == 'push'
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      actions: read
      contents: read
    env:
      GH_TOKEN: {% raw %}${{ github.token }}{% endraw +%}
      GH_REPO: {% raw %}${{ github.repository }}{% endraw +%}
      BEFORE: {% raw %}${{ github.event.before }}{% endraw +%}
      SHA: {% raw %}${{ github.sha }}{% endraw +%}
    steps:
      - name: Wait for this commit's image
        run: |
          changed=$(gh api "repos/$GH_REPO/compare/$BEFORE...$SHA" --jq '.files[].filename')
          # The same paths that trigger publish-image.yml.
          if ! grep -qE '^(src/|Dockerfile$|\.github/workflows/publish-image\.yml$)' <<<"$changed"; then
            echo "This push changes no image paths."
            exit 0
          fi
          run=""
          for _ in $(seq 30); do
            run=$(gh run list --workflow publish-image.yml --commit "$SHA" --event push \
              --limit 1 --json databaseId --jq '.[0].databaseId // empty')
            [ -n "$run" ] && break
            sleep 10
          done
          if [ -z "$run" ]; then
            echo "::error::No Publish image run for $SHA."
            exit 1
          fi
          gh run watch "$run" --exit-status --interval 15

{% endif %}
  chart:
{% if github.publishImage %}
    needs: wait-for-image
    # The wait is skipped outside a push to main. A skipped need skips this job
    # too unless it says otherwise.
    if: {% raw %}${{ !failure() && !cancelled() }}{% endraw +%}
{% endif %}
    # No chart list. The workflow walks helm/*/Chart.yaml and publishes each
    # one to the ECR repository named by its own Chart.yaml.
    uses: Fomiller/gh-actions/.github/workflows/helm-ecr.yaml@main
    permissions:
      id-token: write
      # The release is tagged in this repo.
      contents: write
    with:
      # A pull request packages the chart and throws it away. A merge to main
      # and a manual run both publish.
      push: {% raw %}${{ github.event_name != 'pull_request' }}{% endraw +%}
      # Each chart's version is computed from conventional commits touching its
      # own directory, tagged <chart>-v<version>, and stamped into Chart.yaml at
      # build time. The committed version is only the starting point.
      release-versioning: true
      release-rc: {% raw %}${{ github.ref_name != github.event.repository.default_branch }}{% endraw +%}
    secrets: inherit
{% endif %}
