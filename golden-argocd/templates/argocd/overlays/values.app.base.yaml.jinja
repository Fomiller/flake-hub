{% if argocd.enabled %}
# Written once, then it is yours. `nix run .#generate` never touches it again.
#
# Shared chart values. Every overlay inflates the chart with this file first
# and layers its own values.app.yaml on top, so a per-environment file only
# carries what actually differs.

fullnameOverride: {{ name }}

replicas: {{ argocd.replicas }}

image:
  repository: {{ argocd.registry }}/{{ name }}

# The registry above is private, so the kubelet needs a credential to pull
# from it. external-secrets mints this Secret into every namespace labelled
# for it; the name has to match what that ClusterExternalSecret creates.
imagePullSecrets:
  - name: ecr-image-pull
{% endif %}
