{% if argocd.enabled %}
# Written once, then it is yours. `nix run .#generate` never touches it again.

replicas: 1

# A hello-world until the repo has an image of its own. http-echo takes the
# port on the command line, so it serves on whatever port the chart declares.
image:
  repository: hashicorp/http-echo
  tag: "1.0"

args:
  - -listen=:{{ service.port }}
  - -text=hello from {{ name }}

# Empty here on purpose. The default image is public and needs no credential.
# An overlay pulling from a private registry names its own Secret — see
# argocd/overlays/values.app.base.yaml.
imagePullSecrets: []
{% endif %}
