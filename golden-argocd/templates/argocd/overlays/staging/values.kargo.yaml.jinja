{% if argocd.enabled and argocd.kargo and argocd.environment == "staging" %}# Written once, then it is yours. `nix run .#generate` never touches it again.
#
# The staging promotion pipeline, rendered by kargo-project-chart. See that chart's
# README for every field; what is here is the smallest pipeline that works.

project:
  name: {{ name }}
  # Promotions commit back into this repo. The chart version and the image tag
  # both live in argocd/overlays/, so a promotion touches only files a reader
  # of this repo can find.
  repoURL: https://github.com/Fomiller/{{ name }}.git

services:
  - name: {{ name }}
    image:
      repoURL: 695434033664.dkr.ecr.us-east-1.amazonaws.com/{{ name }}

charts:
  - name: {{ name }}-chart
    chart:
      repoURL: oci://695434033664.dkr.ecr.us-east-1.amazonaws.com/{{ name }}-chart

warehouses:
  - name: {{ name }}
    interval: 5m0s
    # One warehouse subscribing to both, so a promotion carries a matched pair
    # rather than letting the image and the chart drift a release apart.
    services: [{{ name }}]
    charts: [{{ name }}-chart]
    # Two origins from one definition: `{{ name }}` takes the stable releases a
    # merge to main cuts, `{{ name }}-rc` takes the candidates a manual run
    # cuts off a branch. The stage below reads the primary one, so a candidate
    # is tracked and visible without deploying anywhere until a stage asks for
    # it by name.
    #
    # Mutually exclusive with allowTagsRegex — the channels carry the patterns.
    channels: [release, rc]
    updatePaths:
      - path: argocd/overlays/staging/values.app.yaml
        rootRelative: true
        updates:
          - { key: image.tag, source: {{ name }} }
      - path: argocd/overlays/staging/kustomization.yaml
        rootRelative: true
        updates:
          - { key: helmCharts.0.version, source: {{ name }}-chart }

stages:
  - name: staging
    color: green
    autoPromotion: true
    warehouses: [{{ name }}]
    env: staging
    git:
      repoURL: https://github.com/Fomiller/{{ name }}.git
      branch: main
{% endif %}