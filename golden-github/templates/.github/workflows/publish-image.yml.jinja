{% if github.publishImage %}
{% include "_github_header.jinja" %}

name: Publish image

on:
  pull_request:
    paths: [src/**, Dockerfile, .github/workflows/publish-image.yml]
  push:
    branches: [main]
    paths: [src/**, Dockerfile, .github/workflows/publish-image.yml]
  # Cuts a release candidate off whatever branch it runs from, so a build can
  # be published and deployed before it merges. Run from main and it cuts the
  # stable release a merge would have cut.
  workflow_dispatch:

jobs:
  image:
    uses: Fomiller/gh-actions/.github/workflows/docker-ecr.yaml@main
    permissions:
      id-token: write
      # The release is tagged in this repo.
      contents: write
    with:
      repository: {{ name }}
      platforms: {{ github.platforms | join(",") }}
      # A pull request builds the image and throws it away. A merge to main
      # and a manual run both publish.
      push: {% raw %}${{ github.event_name != 'pull_request' }}{% endraw +%}
      # One immutable tag per release, computed from conventional commits since
      # this stream's last tag. The chart is a separate stream, so only the
      # paths above count toward the bump.
      release-tag-prefix: {{ name }}-v
      release-paths: |
        src
        Dockerfile
      release-rc: {% raw %}${{ github.ref_name != github.event.repository.default_branch }}{% endraw +%}
    secrets: inherit
{% endif %}
