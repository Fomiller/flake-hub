{% if argocd.enabled %}{% include "_argocd_header.jinja" %}
#
# What homelab reads to build this repo's Argo CD Application. Its
# ApplicationSet lists repo URLs and asks each one for this file, so a service
# declares its own destination instead of homelab holding a copy.
#
# Managed, unlike everything under argocd/overlays/: these fields come from
# repo.nix and change only when the repo is renamed or moved.

name: {{ name }}
env: {{ argocd.environment }}
namespace: {{ argocd.namespace or name }}

# Where Argo CD sends sync notifications. Empty means none.
notifications: "{{ argocd.notifications }}"
{% endif %}
