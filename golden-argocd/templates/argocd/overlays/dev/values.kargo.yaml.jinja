{% if argocd.enabled and argocd.kargo and argocd.environment == "dev" %}# Written once, then it is yours. `nix run .#generate` never touches it again.
#
# The dev promotion pipeline, rendered by kargo-project-chart. See that chart's
# README for every field; what is here is the smallest pipeline that works.

project:
  name: {{ name }}
  # Promotions commit back into this repo. The chart version and the image tag
  # both live in argocd/overlays/, so a promotion touches only files a reader
  # of this repo can find.
  repoURL: https://github.com/Fomiller/{{ name }}.git

services:
  - name: {{ name }}
    image:
      repoURL: 695434033664.dkr.ecr.us-east-1.amazonaws.com/{{ name }}

charts:
  - name: {{ name }}-chart
    chart:
      repoURL: oci://695434033664.dkr.ecr.us-east-1.amazonaws.com/{{ name }}-chart

warehouses:
  # Named for the lane, not the service. Every object here already lives in
  # this service's namespace, so repeating the name spends the whole width of
  # a Kargo graph node on the one word that says nothing.
  - name: release
    interval: 5m0s
    # One warehouse subscribing to both, so a promotion carries a matched pair
    # rather than letting the image and the chart drift a release apart.
    services: [{{ name }}]
    charts: [{{ name }}-chart]
    # Two origins from one definition: `release` takes the stable versions a
    # merge to main cuts, `release-rc` takes the candidates a manual run cuts
    # off a branch. The stage below reads both.
    #
    # Mutually exclusive with allowTagsRegex — the channels carry the patterns.
    channels: [release, rc]
    updatePaths:
      - path: argocd/overlays/dev/values.app.yaml
        rootRelative: true
        updates:
          - { key: image.tag, source: {{ name }} }
      - path: argocd/overlays/dev/kustomization.yaml
        rootRelative: true
        updates:
          - { key: helmCharts.0.version, source: {{ name }}-chart }

stages:
  - name: dev
    color: green
    # Both lanes land in the one cluster this repo has, so dev takes either: a
    # stable version, or a candidate you want to try before cutting one.
    #
    # That costs autoPromotion, which the chart refuses alongside `channels`.
    # Auto-promotion runs per freight origin, so a stage holding two would
    # promote the newest of each and they would overwrite this overlay in turn.
    # Every promotion here is a click, releases included.
    channels: [release, rc]
    warehouses: [release]
    env: dev
    git:
      repoURL: https://github.com/Fomiller/{{ name }}.git
      branch: main
{% endif %}