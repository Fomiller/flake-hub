{% if argocd.enabled %}
{% raw %}{{- /* Written once, then it is yours. */ -}}
apiVersion: v1
kind: Service
metadata:
  name: {{ include "chart.fullname" . }}
spec:
  selector:
    {{- include "chart.selectorLabels" . | nindent 4 }}
  ports:
    - port: {% endraw %}{{ service.port }}
      targetPort: {{ service.port }}
{% endif %}
