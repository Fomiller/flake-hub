{% include "_github_header.jinja" %}

name: Generate

# No path filter: Drift Check also has to catch a hand-edit to a generated file.
on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch: {}

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw +%}
  cancel-in-progress: true

jobs:
  golden:
    uses: Fomiller/gh-actions/.github/workflows/golden-generate.yaml@main
    permissions:
      contents: read
    secrets: inherit
