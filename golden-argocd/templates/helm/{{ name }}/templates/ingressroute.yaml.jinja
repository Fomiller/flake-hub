{% if argocd.enabled %}
{% raw %}{{- /* GENERATED FILE — managed by flake-hub (golden-argocd). */ -}}
{{- /* Traefik's own CRD rather than a networking.k8s.io Ingress. The homelab
       runs Traefik, and the Cloudflare tunnel forwards every routed hostname
       to it, so the Ingress abstraction would buy nothing here.

       Off unless an overlay sets a host: a chart rendered with no routing
       should produce no route, not a route to "". */}}
{{- if .Values.ingressRoute.host }}
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ include "chart.fullname" . }}
spec:
  entryPoints:
    - {{ .Values.ingressRoute.entryPoint }}
  routes:
    - match: Host(`{{ .Values.ingressRoute.host }}`)
      kind: Rule
      services:
        - name: {{ include "chart.fullname" . }}
          port: {% endraw %}{{ service.port }}{% raw %}
{{- end }}{% endraw %}
{% endif %}
