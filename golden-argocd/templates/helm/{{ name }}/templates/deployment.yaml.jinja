{% if argocd.enabled %}
{# Helm and Jinja share {{ }}. Everything Helm must see verbatim stays inside
   raw; only the build-time values step outside it. #}
{% raw %}{{- /* GENERATED FILE — managed by flake-hub (golden-argocd). */ -}}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ include "chart.fullname" . }}
spec:
  replicas: {{ .Values.replicas }}
  selector:
    matchLabels:
      {{- include "chart.selectorLabels" . | nindent 6 }}
  template:
    metadata:
      labels:
        {{- include "chart.selectorLabels" . | nindent 8 }}
    spec:
      {{- /* Omitted entirely when empty, so a chart rendered against a public
             registry carries no reference to a Secret that isn't there. */}}
      {{- with .Values.imagePullSecrets }}
      imagePullSecrets:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      containers:
        - name: app
          image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
          ports:
            - containerPort: {% endraw %}{{ service.port }}
{% if argocd.healthPath %}
          readinessProbe:
            httpGet:
              path: {{ argocd.healthPath }}
              port: {{ service.port }}
            periodSeconds: 5
          {# Slower and more forgiving than readiness on purpose. Readiness
             pulls a struggling pod out of the Service; liveness kills it, so
             it should only fire once the pod is genuinely stuck. #}
          livenessProbe:
            httpGet:
              path: {{ argocd.healthPath }}
              port: {{ service.port }}
            periodSeconds: 20
            failureThreshold: 3
{% endif %}
{% endif %}
