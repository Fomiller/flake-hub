{% if just.enabled %}
{% include "_base_header.jinja" %}

import? 'just/base.just'

project := "{{ name }}"
{% for v in just.variables %}{{ v.name }} := "{{ v.value }}"
{% endfor %}
{# trim_blocks eats the newline that closes the loop, so the blank line below
   is the one that separates the variables from the first recipe. #}

fetch:
    curl -sSfL https://raw.githubusercontent.com/Fomiller/justfiles/refs/heads/main/base.just > just/base.just

generate:
    nix run .#generate
{% for recipe in just.recipes %}

{# A recipe is either literal text, or an attrset naming a command in the
   language registry. Pack defaults are static data and cannot look anything
   up, so the resolution has to happen here, where `language` is in scope. #}
{% if recipe is mapping %}{{ recipe.name }}:
    {{ languages[language][recipe.cmdFrom] }}
{% else %}{{ recipe }}
{% endif %}
{% endfor %}
{% endif %}
