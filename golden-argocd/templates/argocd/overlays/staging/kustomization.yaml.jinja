{% if argocd.enabled and "staging" in argocd.environments %}# Written once, then it is yours. `nix run .#generate` never touches it again.
#
# `version` below is the deployed chart version. A promotion tool rewrites
# it on each release, which is why this file is written once rather than
# regenerated — a regenerate would put repo.nix's value back.

apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

helmCharts:
  - name: {{ name }}-chart
    repo: oci://{{ argocd.registry }}
    version: {{ argocd.chartVersion }}
    releaseName: {{ name }}-staging
    namespace: {{ name }}
    # Shared defaults first, this environment's overrides second. On a key both
    # files set, the later one wins.
    valuesFile: ../values.app.base.yaml
    additionalValuesFiles:
      - values.app.yaml
{% endif %}
